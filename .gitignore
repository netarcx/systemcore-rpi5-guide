# Large binary files (not tracked in git)
*.img
*.img.xz
*.zip
*.deb
*.tar.gz
*.tar.xz

# Upstream kernel source tree (multi-GB, fetched on demand)
rpi-linux/

# Build output
output/
cache/

# NFS root and TFTP boot files (generated)
netboot/nfsroot/
netboot/rootfs.img
netboot/tftpboot/

# Upstream source reference
systemcore-os-public-*/

# Claude Code local settings
.claude/

# Python bytecode (from the patcher package)
__pycache__/
*.pyc
